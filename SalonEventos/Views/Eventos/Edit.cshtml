@model SalonEventos.Models.Evento

<h2 class="page-title">✏️ Editar Evento</h2>

<div class="row">

    <!-- FORM -->
    <div class="col-lg-8">

        <div class="card">
            <div class="card-body">

                @if (TempData["ErrorEvento"] != null)
                {
                    <div class="alert alert-danger">
                        ❌ @TempData["ErrorEvento"]
                    </div>
                }

                <form asp-action="Edit">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="NombreCliente"></label>
                        <input asp-for="NombreCliente" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono"></label>
                        <input asp-for="Telefono" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Fecha"></label>
                        <input asp-for="Fecha" type="date" class="form-control" id="fechaInput" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Hora"></label>
                        <input asp-for="Hora" type="time" class="form-control" step="60" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="TipoEvento"></label>
                        <select asp-for="TipoEvento" class="form-control">
                            <option>Cumple infantil</option>
                            <option>Adolescente</option>
                            <option>Bautismo</option>
                            <option>Reunión familiar</option>
                            <option>Otro</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CantidadInvitados"></label>
                        <input asp-for="CantidadInvitados" class="form-control" />
                    </div>

                    <!-- 🔥 ESTADO SOLO VISUAL -->
                    <div class="mb-3">
                        <label>Estado</label>
                        <input type="text" class="form-control" value="@Model.Estado" readonly />
                    </div>

                    <div class="section-actions">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        <a asp-action="Index" class="btn btn-outline-dark">Volver</a>
                    </div>

                </form>

            </div>
        </div>

    </div>

    <!-- CALENDARIO -->
    <div class="col-lg-4">

        <div class="card sticky-calendar">
            <div class="card-body">

                <h6>📅 Eventos</h6>

                <div id="miniCalendar"></div>

            </div>
        </div>

    </div>

</div>

<!-- MODAL -->
<div id="modalMini" class="modal-custom">
    <div class="modal-content-custom">
        <span class="close-btn" onclick="cerrarMini()">✖</span>
        <div id="contenidoMini"></div>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

        fetch('/Eventos/GetEventosJson')
        .then(res => res.json())
        .then(eventos => {

        var calendar = new FullCalendar.Calendar(document.getElementById('miniCalendar'), {
        initialView: 'dayGridMonth',
        height: 280,
        locale: 'es',
        headerToolbar: {
        left: 'prev,next',
        center: 'title',
        right: ''
        },
        events: eventos,

        // 🔥 CLICK EN DÍA
        dateClick: function(info) {

        // 👉 OPCIONAL: cargar fecha en el input
        document.getElementById("fechaInput").value = info.dateStr;

        var fecha = info.dateStr;
        var eventosDelDia = eventos.filter(e => e.start === fecha);

        var html = "<h5>Eventos del " + fecha + "</h5>";

        if (eventosDelDia.length === 0) {
        html += "<p>No hay eventos</p>";
        } else {
        eventosDelDia.forEach(e => {
        html += `
        <div class="card p-2 mb-2">
        <strong>${e.title}</strong><br/>
        🕒 ${e.hora}
        </div>`;
        });
        }

        document.getElementById("contenidoMini").innerHTML = html;
        document.getElementById("modalMini").style.display = "flex";
        }
        });

        calendar.render();
        });

        });

        function cerrarMini() {
        document.getElementById("modalMini").style.display = "none";
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}

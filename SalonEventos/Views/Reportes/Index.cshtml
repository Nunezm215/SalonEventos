```html
@model SalonEventos.Models.BalanceMensualViewModel

<h2 class="page-title">📄 Reporte mensual actual (@Model.Mes.ToString("00")/@Model.Anio)</h2>

@if (TempData["ReporteOk"] != null)
{
    <div class="alert alert-success">@TempData["ReporteOk"]</div>
}

@if (TempData["ReporteError"] != null)
{
    <div class="alert alert-danger">@TempData["ReporteError"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        <form asp-action="Generar" method="post" class="d-flex gap-2 flex-wrap">
            @Html.AntiForgeryToken()
            <input type="hidden" name="mes" value="@Model.Mes" />
            <input type="hidden" name="anio" value="@Model.Anio" />

            <!-- BOTON PRINCIPAL -->
            <button type="submit" class="btn btn-danger">
                📄 Generar / actualizar PDF de este mes
            </button>

            <!-- 🔥 FIX -->
            <a asp-action="Historial" class="btn btn-secondary">
                📁 Ver meses anteriores
            </a>

            @if (ViewBag.ReporteActualId != null)
            {
                <a asp-action="Descargar" asp-route-id="@ViewBag.ReporteActualId" class="btn btn-primary">
                    ⬇️ Descargar PDF actual
                </a>
            }
        </form>

        @if (ViewBag.ReporteActualFecha != null)
        {
            <!-- 🔥 FIX COLOR -->
            <p class="mt-3 mb-0" style="color:#9ca3af;">
                Última generación:
                @(((DateTime)ViewBag.ReporteActualFecha).ToString("dd/MM/yyyy HH:mm"))
            </p>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="stat-card bg-success text-white">
            <h5>Ingresos</h5>
            <h3>@Model.Ingresos.ToString("C")</h3>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <!-- 🔥 FIX -->
        <div class="stat-card bg-warning text-dark">
            <h5>Por cobrar</h5>
            <h3>@Model.PorCobrar.ToString("C")</h3>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="stat-card bg-danger text-white">
            <h5>Gastos</h5>
            <h3>@Model.Gastos.ToString("C")</h3>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="stat-card bg-primary text-white">
            <h5>Balance</h5>
            <h3>@Model.Balance.ToString("C")</h3>
        </div>
    </div>
</div>
```

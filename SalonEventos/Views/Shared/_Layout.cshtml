<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - El Galpón</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- TU CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <div class="app">
        <!-- SIDEBAR -->
        <aside class="sidebar">

            <h3 class="logo">EL GALPON MULTIEVENTOS</h3>

            <a href="/" class="nav-link">🏠 Inicio</a>
            <a href="/Eventos" class="nav-link">📅 Ver Eventos</a>
            <a href="/Eventos/Create" class="nav-link">➕ Crear Evento</a>
            <a href="/Reportes" class="nav-link">📊 Reportes</a>
        </aside>

        <!-- CONTENIDO -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - El Galpón</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FULLCALENDAR CSS (ACÁ VA) -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet" />

    <!-- TU CSS (SIEMPRE DESPUÉS) -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <div class="app">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="logo-container">
                <img src="@Url.Content("~/images/logo2.png")" class="logo-img" />
                <div class="logo-text">El Galpón</div>
            </div>

            <nav class="nav flex-column mt-4">

                <a href="/" class="nav-link">
                    <i class="bi bi-house"></i> Inicio
                </a>

                <a href="/Eventos" class="nav-link">
                    <i class="bi bi-calendar-event"></i> Eventos
                </a>

                <a href="/Eventos/Create" class="nav-link">
                    <i class="bi bi-plus-circle"></i> Crear
                </a>

                <a href="/Reportes" class="nav-link">
                    <i class="bi bi-bar-chart"></i> Reportes
                </a>

            </nav>

        </aside>

        <!-- CONTENIDO -->
        <div class="container-fluid">

            <!-- TOPBAR -->
            

            <!-- MAIN -->
            <main class="main-content">
                @RenderBody()
            </main>

        </div>

    </div>

    @RenderSection("Scripts", required: false)

</body>
</html>
@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-panel mb-4">
    <h1 class="mb-3">Gestion del salon en un solo panel</h1>
    <p class="mb-0">Crea eventos, registra pagos y controla reportes mensuales desde una interfaz simple y ordenada.</p>
</section>

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Accesos rapidos</h5>
        <div class="section-actions mb-0">
            <a href="/Eventos" class="btn btn-primary">📅 Ver Eventos</a>
            <a href="/Eventos/Create" class="btn btn-success">➕ Crear Evento</a>
            <a href="/Reportes" class="btn btn-warning text-dark">📄 Reporte mensual</a>
            <a href="/Movimientos/Create?tipo=Gasto" class="btn btn-danger">➖ Cargar gasto</a>
        </div>
    </div>
</div>
